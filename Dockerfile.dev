FROM node:24-alpine@sha256:50c8e8ca1d27439048670df5883f32d57cf81cff6233222c893fd0d9884cbd81

# Install wget for healthcheck
RUN apk add --no-cache wget

WORKDIR /app

# Copy package files first for better layer caching
COPY package*.json ./

# Install dependencies using npm ci for consistent, reproducible builds
# This runs during build time to create the base node_modules
RUN npm ci

# Copy the rest of the application
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Use a script to ensure dependencies are in sync when container starts
# This handles the case where package.json might have changed on the host
CMD sh -c "npm ci && npm run dev -- --host 0.0.0.0"
