# VCS provider credentials. Read by the api service.
# Copy to vcs.env before starting the stack:  cp vcs.env.example vcs.env
#
# Every value may be left empty. An empty file is valid and simply means no VCS
# provider is connected - workspaces can still be driven through the API, the CLI
# and the Terraform provider. See the VCS user guides for provider setup.

# GITHUB_WEBHOOK_SECRET - required for GitHub webhooks. Incoming deliveries are
# authenticated by HMAC-SHA256 of the body against this value, and the endpoint
# rejects every delivery with 401 while it is unset. Use the same value in the
# GitHub App's webhook settings.
#GITHUB_WEBHOOK_SECRET=

# Public base URL of this Stackweaver API, used to register webhooks automatically.
# Must be reachable from the VCS provider, so a public hostname or tunnel URL -
# not localhost.
# Example: STACKWEAVER_WEBHOOK_BASE_URL=https://stackweaver.example.com:8022
#STACKWEAVER_WEBHOOK_BASE_URL=

# Azure DevOps - Microsoft Entra ID OAuth2.
# Register at https://portal.azure.com -> Microsoft Entra ID -> App registrations.
#AZURE_DEVOPS_CLIENT_ID=        # Application (client) ID from the Entra app registration
#AZURE_DEVOPS_CLIENT_SECRET=    # Client secret value (Certificates & secrets tab)
#AZURE_DEVOPS_REDIRECT_URI=http://localhost:5173/vcs/azure-devops/callback
#AZURE_DEVOPS_TENANT_ID=common  # "common" for multi-tenant, or your Entra tenant ID/domain
#AZURE_DEVOPS_WEBHOOK_SECRET=   # required for ADO webhooks - the Basic-auth password each
                                # service-hook subscription sends; deliveries without it are rejected (401)
