# OIDC workload identity signing key. Read by the api and runner services.
# Copy to oidc.env before starting the stack:  cp oidc.env.example oidc.env
#
# OIDC_SIGNING_KEY is required: the API refuses to start without it, and the
# runners start with workload identity disabled. OIDC_ISSUER_URL may be left
# empty. See the OIDC configuration guide for the full setup.

# Base64-encoded RSA-2048 private key used to sign workload identity tokens.
# The API and the runners MUST share the same key: it is the key the runner
# signs with and the key the API publishes in its JWKS endpoint.
#
# Generate with:  openssl genrsa 2048 | base64 -w 0
OIDC_SIGNING_KEY=

# Public issuer URL embedded in issued tokens and served in the discovery
# document. Must exactly match the issuer configured on the federated identity
# credential at your cloud provider. Defaults to API_URL when unset.
OIDC_ISSUER_URL=
