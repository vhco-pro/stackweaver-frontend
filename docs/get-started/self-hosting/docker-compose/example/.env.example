# StackWeaver Docker Compose - Environment Variables
# Copy this file to .env before starting:  cp .env.example .env
#
# On first startup, the zitadel-init container auto-generates Zitadel
# credentials and appends them to this file. Do not edit those values.

# ── Database ─────────────────────────────────────────────────────────
POSTGRES_USER=iac
POSTGRES_PASSWORD=iac_password
POSTGRES_DB=iac_platform

# ── Object Storage (Garage S3-compatible) ────────────────────────────
STORAGE_ACCESS_KEY=GK000000000000000000000000
STORAGE_SECRET_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# ── Encryption ───────────────────────────────────────────────────────
# REQUIRED. 32-byte (64 hex chars) AES-256 key for encrypting sensitive data
# at rest (Ansible credentials, variable values, etc.). Generate a unique key:
#   openssl rand -hex 32
# The ansible-runner refuses to start with a missing or all-zero key, and
# docker compose will refuse to bring the stack up until you set a real value.
ENCRYPTION_KEY=

# ── Zitadel ──────────────────────────────────────────────────────────
# Masterkey for Zitadel encryption (must be exactly 32 characters)
ZITADEL_MASTERKEY=LfcvxoyK4yAwsyp5WYeA3siK61yl7064

# Admin password for the default Zitadel admin user (admin@ZITADEL.localhost)
ZITADEL_ADMIN_PASSWORD=Password1!

# Zitadel issuer URL (change if using a custom domain)
ZITADEL_ISSUER=http://localhost:8080
# The domain Zitadel serves (ExternalDomain in zitadel-defaults.yaml, without scheme or port).
# The API names the Zitadel instance with it, so it must be right before the first start. If you
# change the external domain, change it here and in ZITADEL_ISSUER together.
ZITADEL_EXTERNAL_HOST=localhost

# ── Frontend ─────────────────────────────────────────────────────────
# The frontend-config container writes these into env.js, the SPA's runtime configuration,
# each time the stack is brought up. Change them if using a custom domain or reverse proxy.
VITE_API_URL=http://localhost:5173/api/v2
VITE_ZITADEL_REDIRECT_URI=http://localhost:5173/auth/callback

# ── Application URL ─────────────────────────────────────────────────
# Public URL of the StackWeaver frontend SPA. Used by the auth proxy to
# build IdP success/failure URLs that land on the SPA (required when the
# api and SPA live on different hostnames - split-domain deployments) and
# by GitHub App callback URLs.
STACKWEAVER_APP_URL=http://localhost:5173

# ── GitHub App (optional) ────────────────────────────────────────────
# GITHUB_APP_ID=
# GITHUB_APP_NAME=
# The webhook secret belongs in vcs.env, not here.

# ── Custom Domain (optional) ────────────────────────────────────────
# ZITADEL_CUSTOM_DOMAINS=auth.example.com
# CORS_EXTRA_ORIGINS=https://app.example.com

# ── Log Level ────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────
# Everything below this line is auto-generated by zitadel-init.
# Do not edit manually.
# ─────────────────────────────────────────────────────────────────────
