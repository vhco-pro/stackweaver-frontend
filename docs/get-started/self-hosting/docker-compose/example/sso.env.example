# SSO / external IdP credentials. Read by the zitadel-init and api services.
# Copy to sso.env before starting the stack:  cp sso.env.example sso.env
#
# Every value may be left empty. An empty file is valid and simply means no
# external identity provider is configured - local Zitadel accounts still work.
# See the SSO user guides for provider-specific setup.

# Azure AD / Entra ID
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Generic OIDC (Okta, Cognito, etc.)
OIDC_IDP_NAME=
OIDC_IDP_ISSUER=
OIDC_IDP_CLIENT_ID=
OIDC_IDP_CLIENT_SECRET=

# Team sync (API). ENABLE_OIDC_TEAM_SYNC maps IdP groups onto Stackweaver teams;
# OIDC_REMOVE_FROM_NON_SSO_TEAMS also strips memberships the IdP does not grant.
ENABLE_OIDC_TEAM_SYNC=true
OIDC_REMOVE_FROM_NON_SSO_TEAMS=false
