# SSO / external IdP credentials. Read by the zitadel-init and api services.
# Copy to sso.env before starting the stack:  cp sso.env.example sso.env
#
# Every value may be left empty. An empty file is valid and simply means no
# external identity provider is configured - local Zitadel accounts still work.
# See the SSO user guides for provider-specific setup.

# Azure AD / Entra ID. AZURE_AD_TENANT_ID is required: without it any Microsoft
# account could sign in and create an account. To allow that deliberately, set
# AZURE_AD_ALLOW_MULTI_TENANT=true instead.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_ALLOW_MULTI_TENANT=false

# Generic OIDC (Okta, Cognito, etc.)
OIDC_IDP_NAME=
OIDC_IDP_ISSUER=
OIDC_IDP_CLIENT_ID=
OIDC_IDP_CLIENT_SECRET=

# Identity mail (SMTP). zitadel-init configures this as Zitadel's email provider,
# which sends verification, password-reset and email login codes. Without
# SMTP_HOST, self-registration, self-service password reset and email codes are
# switched off. Any transactional provider with SMTP submission works (port 587
# STARTTLS or 465 TLS); the sending domain needs SPF, DKIM and DMARC records.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_ADDRESS=
SMTP_SENDER_NAME=Stackweaver
SMTP_TLS=true

# Let anyone create an account. Takes effect only when SMTP_HOST is set, because
# new accounts must verify their email.
STACKWEAVER_SELF_REGISTRATION=false

# Team sync (API). ENABLE_OIDC_TEAM_SYNC maps IdP groups onto Stackweaver teams;
# OIDC_REMOVE_FROM_NON_SSO_TEAMS also strips memberships the IdP does not grant.
ENABLE_OIDC_TEAM_SYNC=true
OIDC_REMOVE_FROM_NON_SSO_TEAMS=false
