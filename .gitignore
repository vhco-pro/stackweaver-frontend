# fallow (dead-code analysis): cache + generated SARIF. The committed baseline
# under fallow-baselines/ is intentionally tracked and must NOT be ignored.
.fallow/
*.sarif

# Leftovers from the image-optimisation cache that scripts/build-docs-index.js used to keep
# (removed in #801: it could never hit, and re-optimising the whole corpus costs ~0.26s).
# Ignored rather than forgotten so a stale working copy does not reappear in a commit.
.image-cache.json
.docs-image-cache/
test-results/
*.local

