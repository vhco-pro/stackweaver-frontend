## Examples

### Modern Card Component
```tsx
import { cn } from '@/lib/utils';

interface ModernCardProps {
  title: string;
  description?: string;
  children?: React.ReactNode;
  gradient?: 'purple' | 'blue' | 'pink';
}

export function ModernCard({ title, description, children, gradient = 'purple' }: ModernCardProps) {
  const gradientClasses = {
    purple: 'from-purple-500/20 via-pink-500/20 to-orange-500/20',
    blue: 'from-blue-500/20 via-cyan-500/20 to-teal-500/20',
    pink: 'from-pink-500/20 via-rose-500/20 to-red-500/20',
  };

  return (
    <div className={cn(
      "relative overflow-hidden rounded-2xl",
      "bg-gradient-to-br",
      gradientClasses[gradient],
      "backdrop-blur-md border border-white/20",
      "p-6 shadow-xl shadow-purple-500/10",
      "transition-all duration-300",
      "hover:shadow-2xl hover:shadow-purple-500/20 hover:scale-[1.02]"
    )}>
      <h3 className="text-xl font-semibold mb-2 bg-gradient-to-r from-white to-white/80 bg-clip-text text-transparent">
        {title}
      </h3>
      {description && (
        <p className="text-muted-foreground mb-4">
          {description}
        </p>
      )}
      {children}
    </div>
  );
}
```

