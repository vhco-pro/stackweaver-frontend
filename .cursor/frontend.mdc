## API Integration

### Client Usage
- Always use the API client from `@/api/client`
- Handle loading, error, and success states
- Use TypeScript types for API responses
- Implement proper error handling

```tsx
// Example with TanStack Query (React Query)
import { useQuery } from '@tanstack/react-query';
import { organizationsApi } from '@/api/client';
import { Skeleton } from '@/components/ui/skeleton';

function OrganizationsList() {
  const { data, isLoading, error, refetch } = useQuery({
    queryKey: ['organizations'],
    queryFn: () => organizationsApi.list(),
  });

  if (isLoading) return <Skeleton className="h-32 w-full" />;
  if (error) return <ErrorState error={error} onRetry={() => refetch()} />;
  return <OrganizationList data={data} />;
}

// Alternative: Direct API calls with useState/useEffect
import { useState, useEffect } from 'react';

function OrganizationsList() {
  const [data, setData] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    organizationsApi.list()
      .then((res) => {
        setData(res.data);
        setIsLoading(false);
      })
      .catch((err) => {
        setError(err);
        setIsLoading(false);
      });
  }, []);

  if (isLoading) return <Skeleton className="h-32 w-full" />;
  if (error) return <ErrorState error={error} onRetry={() => window.location.reload()} />;
  return <OrganizationList data={data} />;
}
```

